# Copy this file to .env before running the app or the crawler:
#   cp .env.example .env

# Base URL this API is served from (used for URL generation, not for scraping --
# uboat.net's own base URL is a fixed constant in the scraper, not configurable).
BASE_URL=http://localhost:8000

# ASGI root_path, if the app is mounted behind a path prefix. Empty for local dev.
ROOT_PATH=

# App package root, used by the route-handler auto-discovery.
BASE_DIR=app

# Directory scanned for RequestHandler route modules.
HTTP_DIR=app/http

# Optional contact string (e.g. an email or URL) included in the crawler's
# User-Agent when it fetches uboat.net. Left empty by default -- opt in if you
# want to identify yourself to the site owner.
CRAWLER_CONTACT=

# Minimum seconds between requests to uboat.net during a crawl. Overridable
# per-run with `poetry run python -m app.crawl --delay N`.
CRAWL_DELAY_SECONDS=10.0
